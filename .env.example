# Supabase Configuration
# Copiez ce fichier en .env et renseignez vos valeurs
# NE JAMAIS committer le fichier .env dans Git

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT : Ne jamais utiliser la service_role key côté client
# La service_role key ne doit être utilisée que côté serveur (fonctions Edge)
